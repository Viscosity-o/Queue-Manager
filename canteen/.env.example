# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    CANTEEN MANAGEMENT SYSTEM — .env                        ║
# ║                                                                            ║
# ║  Copy this file to `.env` and fill in your actual values.                  ║
# ║  NEVER commit the real `.env` to version control.                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; Spring Boot reads SERVER_PORT.
SERVER_PORT=${PORT:8080}

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Format: jdbc:postgresql://<HOST>:<PORT>/<DB_NAME>
# Supabase Session-Pooler example:
#   jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=86400000

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ── CORS (Frontend URL) ──────────────────────────────────────────────────────
# Comma-separated if multiple origins needed
CORS_ALLOWED_ORIGINS=https://main.d2p2ult8kyt0kl.amplifyapp.com,http://localhost:5173,http://localhost:3000
